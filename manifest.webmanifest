{
 "name": "Karryman 4.0",
 "short_name": "Karryman",
 "start_url": "./plan.html",
 "scope": "./",
 "display": "standalone",
 "background_color": "#f4f6f0",
 "theme_color": "#f4f6f0",
 "icons": [
  {
   "src": "./icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "./icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "./icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "./karryman-icon.svg",
   "sizes": "any",
   "type": "image/svg+xml",
   "purpose": "any"
  }
 ],
 "id": "./plan.html",
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "files": [
    {
     "name": "file",
     "accept": [
      "text/plain",
      "text/csv",
      "text/comma-separated-values",
      "application/csv",
      "application/vnd.ms-excel",
      "application/octet-stream",
      ".csv",
      ".txt",
      ".plain"
     ]
    }
   ]
  }
 }
}